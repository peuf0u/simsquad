# simsquad.toml — example configuration
#
# Copy to `simsquad.toml` (team defaults, commit to git) and edit. Anything
# developer-specific — chiefly the absolute repo paths — belongs in
# `simsquad.local.toml` instead (gitignored; same schema, deep-merged on top).
#
# Resolution precedence, highest to lowest:
#   CLI flag  >  env var  >  simsquad.local.toml  >  simsquad.toml  >  default
#
# `simsquad equip` writes both files for you interactively.

# ---------------------------------------------------------------------------
# [project] — what to build and where.
# ---------------------------------------------------------------------------
[project]
# Absolute paths to the app repos. Relative paths resolve against this config
# file's directory; ~ is expanded. Usually set these in simsquad.local.toml so
# each developer can point at their own checkout. When the config lives in
# the app repo, ios_repo = "." in this file builds whichever checkout or git
# worktree the config is in (see docs/agent-testing.md).
#   ios_repo     = "~/code/myapp-ios"
#   android_repo = "~/code/myapp-android"

# xcodebuild scheme (default "App") and Gradle task (default
# ":app:assembleDebug"). Override per-invocation with
# --ios-scheme / --gradle-task. A bundle* task (":app:bundleDevDebug")
# installs dynamic feature modules too and needs bundletool
# (brew install bundletool); see the README.
ios_scheme          = "MyApp"
android_gradle_task = ":app:assembleDevDebug"

# ---------------------------------------------------------------------------
# [context] — project-wide test context, applied to every squad at deploy time.
# ---------------------------------------------------------------------------
# Free-form string map. simsquad never interprets these — they're passed
# through to consumers (qa-run, CI, your AI agent) verbatim.
#
# Precedence: if ANY `--context KEY=VALUE` flag is passed to `deploy`, this
# [context] block is ignored entirely and only the CLI values apply (mirrors
# how --ios-spec replaces the [[ios.sims]] matrix). Use `simsquad set-context`
# to mutate a live squad's context after deploy. Before 0.5.0 this table was
# [env]; that name still loads, with a deprecation warning.
#
# Put real secrets in [secrets] in simsquad.local.toml, not here. A key whose
# name contains password, secret or token is masked as a secret even here.
[context]
api = "staging"
# user         = "alice"      # better in simsquad.local.toml
# feature_flag = "new_ui"

# ---------------------------------------------------------------------------
# [secrets] — secret test context: test-account passwords, API tokens.
# ---------------------------------------------------------------------------
# Belongs in simsquad.local.toml (deploy warns when this committed file has
# it; `simsquad equip` saves it there). Keys join the squad context as
# secrets: kept in the squad record, printed as "<secret>" by every command
# and in test reports. `simsquad devices --name X --reveal` prints the real
# values. Any `deploy --secret KEY=VALUE` replaces this table and leaves
# [context] alone; a key in both [context] and [secrets] is an error.
#
# [secrets]
# password = "hunter2"

# ---------------------------------------------------------------------------
# [agent] — agent testing (`simsquad run …`, the generated skills).
# ---------------------------------------------------------------------------
# All keys optional. `simsquad equip` preserves this table when it rewrites
# the file.
[agent]
# Model id for workers, passed to the worker command as given (never
# validated). `run new --model` overrides it. Unset = the default for
# `run new --worker`: "sonnet" for claude (the default worker),
# "gpt-6.1-sol" for codex. The one value applies to claude and codex
# workers alike: set it only when it suits every CLI the team uses, or pass
# `run new --model` per run instead.
# worker_model = "sonnet"
# Squad for test runs (default "qa-<repo>") and for everyday agent use
# (default "dev-<repo>"). Set them when two repos share a folder name.
# test_squad = "qa-myapp"
# dev_squad  = "dev-myapp"

# ---------------------------------------------------------------------------
# [[ios.sims]] / [[android.sims]] — the device matrices.
# ---------------------------------------------------------------------------
# Both matrices act as defaults. Precedence: passing ANY spec flag to
# `deploy` (--ios-spec or --android-spec) replaces the TOML matrix for BOTH
# platforms — omitting a platform's flag in that case skips it for this
# run. Examples:
#
#   simsquad deploy --name=foo                        # both from TOML
#   simsquad deploy --name=foo --ios-spec 'iPhone 17:iOS 26.4:1'
#                                                     # iOS from flag; Android skipped
#   simsquad deploy --name=foo --android-spec '…'     # Android from flag; iOS skipped
#   simsquad deploy --name=foo --ios-spec '…' --android-spec '…'
#                                                     # both from flags
#
# [[ios.sims]] — one table per row; repeatable.
# device  = simctl device type (human name is fine: "iPhone 17")
# runtime = simctl runtime ("iOS 26.4"); normalised to the full identifier
# count   = how many fresh sims of this kind to create
[[ios.sims]]
device  = "iPhone 17"
runtime = "iOS 26.4"
count   = 2

[[ios.sims]]
device  = "iPhone 16 Pro"
runtime = "iOS 26.1"
count   = 1

# [[android.sims]] — one table per row; repeatable. (Spec-flag precedence
# rule is described above the [[ios.sims]] block.)
# device = AVD device profile ("pixel_7")
# image  = avdmanager system-image id. Dotted API levels like "android-36.1"
#          need current command-line tools; older ones reject them.
# count  = how many emulators to create
# target = "emulator" (default) or "physical". Physical rows claim plugged-in
#          adb devices instead of creating emulators; device/image are ignored.
[[android.sims]]
device = "pixel_7"
image  = "system-images;android-34;google_apis;arm64-v8a"
count  = 1
target = "emulator"

# [[android.sims]]
# device = "physical"
# image  = "physical"
# count  = 1
# target = "physical"

# ---------------------------------------------------------------------------
# [device_sets.<name>] — named device matrices beside the default one.
# ---------------------------------------------------------------------------
# Each set holds [[device_sets.<name>.ios.sims]] / [[device_sets.<name>.android.sims]]
# rows shaped exactly like the rows above. A set is only a device matrix: the
# repos, scheme and Gradle task stay in [project].
#
#   simsquad deploy --name=foo --device-set tablet    # this set, both platforms
#   simsquad deploy --name=foo                        # the set foo recorded
#
# --device-set replaces the default matrix for both platforms (like spec
# flags, with which it can't be combined); --platform filters it. The squad
# records the set's name, so a later deploy without matrix flags re-reads the
# set from this file. A set of the same name in simsquad.local.toml replaces
# this one wholesale. `simsquad equip` edits sets under "Device sets…", and
# `equip --add-ios-spec '…' --device-set tablet` appends to one.
#
# [[device_sets.tablet.ios.sims]]
# device  = "iPad Pro 13-inch (M5)"
# runtime = "iOS 26.4"
# count   = 1
#
# [[device_sets.tablet.android.sims]]
# device = "pixel_tablet"
# image  = "system-images;android-34;google_apis;arm64-v8a"
# count  = 1
